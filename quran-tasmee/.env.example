# Copy to .env (never commit it) or set these in your host's dashboard.
NABR_API_KEY=            # from the Nabr / qurani.ai dashboard (subscription required)
PUBLIC_BASE_URL=         # public https address of THIS server, e.g. https://asr.example.org (Nabr downloads the clip from here)
TEACHER_PIN=             # at least 6 characters, for /teacher.html
PORT=8787
